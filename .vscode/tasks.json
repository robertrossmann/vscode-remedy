{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "make: compile",
      "detail": "Compile the project",
      "type": "process",
      "command": "/usr/bin/make",
      "args": [
        "compile"
      ],
      "group": {
        "kind": "build",
      },
      "presentation": {
        "revealProblems": "onProblem",
        "clear": true
      },
      "icon": {
        "id": "files",
        "color": "terminal.ansiGreen"
      },
      "problemMatcher": [
        "$tsc"
      ]
    },
    {
      "label": "make: compile/watch",
      "detail": "Start TypeScript compiler in watch mode",
      "type": "process",
      "command": "/usr/bin/make",
      "args": [
        "compile/watch"
      ],
      "problemMatcher": [
        "$tsc-watch"
      ],
      "group": "build",
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1,
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": true,
        "reveal": "never",
        "revealProblems": "never"
      },
      "icon": {
        "id": "files",
        "color": "terminal.ansiYellow"
      }
    },
    {
      "label": "make:themes",
      "detail": "Compile the sources into the final theme files",
      "type": "process",
      "command": "make",
      "args": [
        "themes"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": [],
      "icon": {
        "id": "package",
        "color": "terminal.ansiBlue"
      }
    },
    {
      "label": "make:lint",
      "detail": "Lint the project",
      "type": "process",
      "command": "make",
      "args": [
        "lint"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "silent",
        "clear": true
      },
      "problemMatcher": "$eslint-stylish",
      "icon": {
        "id": "eye",
        "color": "terminal.ansiGreen"
      }
    },
    {
      "label": "make:distclean",
      "detail": "Remove all compiled artifacts",
      "type": "process",
      "command": "make",
      "args": [
        "distclean"
      ],
      "group": "none",
      "presentation": {
        "clear": true
      },
      "problemMatcher": [],
      "icon": {
        "id": "trash",
        "color": "terminal.ansiRed"
      }
    }
  ]
}
